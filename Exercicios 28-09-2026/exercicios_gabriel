#include <stdio.h>

int main() {
    int num, tentativas = 0;
    
    do {
        printf("Digite um número entre 1 e 100: ");
        scanf("%d", &num);
        tentativas++;
        
        if (num < 1 || num > 100) {
            printf("Erro: Valor fora da faixa (1 a 100). Tente novamente.\n");
        }
    } while (num < 1 || num > 100);
    
    printf("Número válido aceito! Foram necessárias %d tentativa(s).\n", tentativas);
    
    return 0;
}