#include <stdio.h>

int main() {
    float n1, n2, n3;
    float p1, p2, p3;
    float media;
    
    printf("Digite a 1ª nota e seu peso: ");
    scanf("%f %f", &n1, &p1);
    
    printf("Digite a 2ª nota e seu peso: ");
    scanf("%f %f", &n2, &p2);
    
    printf("Digite a 3ª nota e seu peso: ");
    scanf("%f %f", &n3, &p3);
    
    
    if (p1 == 0 || p2 == 0 || p3 == 0) {
        printf("\nErro: Nenhum peso pode ser igual a zero!\n");
    } else {
        
        media = (n1 * p1 + n2 * p2 + n3 * p3) / (p1 + p2 + p3);
        
        printf("\nMédia Ponderada: %.2f\n", media);
        printf("Situação: ");
        
       
        if (media >= 6.0) {
            printf("Aprovado\n");
        } else if (media >= 4.0) {
            printf("Exame\n");
        } else {
            printf("Reprovado\n");
        }
    }
    
    return 0;
}


